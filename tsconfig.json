{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationDir": "dist/types",
    "downlevelIteration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2015", "es2016", "es2017", "es2018.asyncgenerator", "es2018.asynciterable", "dom"],
    "module": "es2015",
    "moduleResolution": "node",
    "outDir": "compiled",
    "sourceMap": true,
    "strict": true,
    "target": "es5",
    "typeRoots": ["node_modules/@types"]
  },
  "include": ["src"],
  "typedocOptions": {
    "entryPoints": ["src/Heap.ts"],
    "out": "docs",
    "theme": "default"
  }
}
